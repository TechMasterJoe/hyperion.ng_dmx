{
	"type":"object",
	"required":true,
	"properties":{
		"dmxtype": {
			"type": "string",
			"title":"edt_dev_spec_ledType_title",
			"enum" : ["raw", "McCrypt", "custom"],
			"default" : "raw",
			"options" : {
				"enum_titles" : ["Raw", "McCrypt", "Custom Fixtures"]
			},
			"minimum" : 0,
			"maximum" : 2,
			"propertyOrder" : 1
		},
		"output": {
			"type": "string",
			"title":"edt_dev_spec_outputPath_title",
			"default":"ttyUSB0",
			"propertyOrder" : 2
		},
		"rateList": {
			"type": "string",
			"title":"edt_dev_spec_baudrate_title",
			"enum": [ "CUSTOM","9600","14400","19200","28800","33600","38400","56000","57600","76800","115200","128000","153600","230400","250000","256000","307200","460800","921600","1000000","1500000","2000000","3000000","4000000" ],
			"options": {
			  "enum_titles": [ "edt_conf_enum_custom" ]
			},
			"default": "250000",
			"access": "advanced",
			"propertyOrder" : 3
		},
		"rate": {
			"type": "integer",
			"title":"",
			"default": 250000,
			"access": "advanced",
			"propertyOrder" : 4
		},		
		"delayAfterConnect": {
			"type": "integer",
			"title":"edt_dev_spec_delayAfterConnect_title",
			"default": 250,
			"access" : "expert",
			"propertyOrder" : 5
		},
		"latchTime": {
			"type": "integer",
			"title":"edt_dev_spec_latchtime_title",
			"default": 10,
			"append" : "edt_append_ms",
			"minimum": 0,
			"maximum": 1000,
			"access" : "expert",
			"propertyOrder" : 6
		},
		"rewriteTime": {
			"type": "integer",
			"title":"edt_dev_general_rewriteTime_title",
			"default": 1000,
			"append" : "edt_append_ms",
			"minimum": 0,
			"access" : "expert",
			"propertyOrder" : 7
		},
		"whiteAlgorithm": {
			"type": "string",
			"title": "White algorithm (for W channels)",
			"enum": ["white_off", "subtract_minimum", "auto"],
			"default": "white_off",
			"access": "expert",
			"propertyOrder": 8
		},
		"customFixtures": {
			"type": "array",
			"title": "Custom DMX Fixtures",
			"description": "Define fixture types with channel roles. When present, overrides raw/McCrypt packing.",
			"access": "expert",
			"propertyOrder": 9,
			"items": {
				"type": "object",
				"headerTemplate": "{{self.name}} ({{self.channelCount}} ch)",
				"properties": {
					"name": { "type": "string", "title": "Fixture name" },
					"channelCount": { "type": "integer", "minimum": 1, "maximum": 512, "title": "Channel count", "default": 4 },
					"channelRoles": {
						"type": "array",
						"title": "Channel roles",
						"items": { 
							"type": "string", 
							"enum": ["R", "G", "B", "W", "H", "L", "F"],
							"options": {
								"enum_titles": ["Red", "Green", "Blue", "White", "High (255)", "Low (0)", "Fixed value"]
							}
						}
					},
					"channelConfig": { "type": "string", "title": "Compact config (e.g. RGBH)" },
					"fixedValues": {
						"type": "array",
						"title": "Fixed values",
						"items": { "type": "integer", "minimum": 0, "maximum": 255 }
					}
				}
			}
		},
		"ledFixtureMap": {
			"type": "array",
			"title": "LED to fixture index map",
			"description": "0-based index into customFixtures for each LED. Empty = all use fixture 0.",
			"access": "expert",
			"propertyOrder": 10,
			"items": { "type": "integer", "minimum": 0 }
		}
	},
	"additionalProperties": true
}
