      "default": "white_off",
      "options": {
        "enum_titles": [
          "edt_dev_enum_subtract_minimum",
          "edt_dev_enum_sub_min_cool_adjust",
          "edt_dev_enum_sub_min_warm_adjust",
          "edt_dev_enum_cold_white",
          "edt_dev_enum_neutral_white",
          "edt_dev_enum_auto",
          "edt_dev_enum_auto_max",
          "edt_dev_enum_auto_accurate",
          "edt_dev_enum_white_off"
        ]
      },
      "propertyOrder": 5
    },
    "customFixtures": {
      "type": "array",
      "title": "Custom DMX Fixtures",
      "access": "expert",
      "propertyOrder": 7,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "title": "Fixture name" },
          "channelCount": { "type": "integer", "minimum": 1, "maximum": 512, "title": "Channel count" },
          "channelRoles": {
            "type": "array",
