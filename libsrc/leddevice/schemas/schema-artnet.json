      "access": "expert",
      "propertyOrder": 8,
      "items": { "type": "integer", "minimum": 0 }
    },
    "latchTime": {
      "type": "integer",
      "title": "edt_dev_spec_latchtime_title",
      "default": 0,
      "append": "edt_append_ms",
      "minimum": 0,
      "maximum": 1000,
      "access": "expert",
      "propertyOrder": 6
