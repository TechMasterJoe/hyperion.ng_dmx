{
  "type": "object",
  "required": true,
  "properties": {
    "host": {
      "type": "string",
      "format": "hostname_or_ip",
      "title": "edt_dev_spec_targetIpHost_title",
      "propertyOrder": 1
    },
    "port": {
      "type": "integer",
      "title": "edt_dev_spec_port_title",
      "default": 6454,
      "minimum": 0,
      "maximum": 65535,
      "propertyOrder": 2
    },
    "universe": {
      "type": "integer",
      "title": "edt_dev_spec_universe_title",
      "default": 1,
      "propertyOrder": 3
