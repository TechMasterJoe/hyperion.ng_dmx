{
  "type": "object",
  "required": true,
  "properties": {
    "host": {
      "type": "string",
      "format": "hostname_or_ip",
      "title": "edt_dev_spec_targetIpHost_title",
      "propertyOrder": 1
    },
    "port": {
      "type": "integer",
      "title": "edt_dev_spec_port_title",
      "default": 6454,
      "minimum": 0,
      "maximum": 65535,
      "propertyOrder": 2
    },
    "universe": {
      "type": "integer",
      "title": "edt_dev_spec_universe_title",
      "default": 1,
      "propertyOrder": 3
    },
    "channelsPerFixture": {
      "type": "integer",
      "title": "edt_dev_spec_chanperfixture_title",
      "default": 3,
      "minimum": 3,
      "propertyOrder": 4
    },
    "whiteAlgorithm": {
      "type": "string",
      "title": "edt_dev_spec_whiteLedAlgor_title",
      "enum": [
        "subtract_minimum",
        "sub_min_cool_adjust",
        "sub_min_warm_adjust",
        "cold_white",
        "neutral_white",
        "auto",
        "auto_max",
        "auto_accurate",
        "white_off"
      ],
      "default": "white_off",
      "options": {
        "enum_titles": [
          "edt_dev_enum_subtract_minimum",
          "edt_dev_enum_sub_min_cool_adjust",
          "edt_dev_enum_sub_min_warm_adjust",
          "edt_dev_enum_cold_white",
          "edt_dev_enum_neutral_white",
          "edt_dev_enum_auto",
          "edt_dev_enum_auto_max",
          "edt_dev_enum_auto_accurate",
          "edt_dev_enum_white_off"
        ]
      },
      "propertyOrder": 5
    },
    "customFixtures": {
      "type": "array",
      "title": "Custom DMX Fixtures",
      "description": "Define one or more fixture types. Each Hyperion LED can be assigned a fixture via the LED Fixture Map. Roles: R/G/B/W = color, H = always 255, L = always 0, F = fixed value.",
      "access": "expert",
      "propertyOrder": 7,
      "options": {
        "infoText": "Use the visual editor below or edit the JSON. Compact channelConfig (e.g. RGBH) is also accepted."
      },
      "items": {
        "type": "object",
        "headerTemplate": "{{self.name}} ({{self.channelCount}} ch)",
        "properties": {
          "name": { 
            "type": "string", 
            "title": "Fixture name",
            "description": "Friendly name shown in the UI"
          },
          "channelCount": { 
            "type": "integer", 
            "minimum": 1, 
            "maximum": 512, 
            "title": "Channel count",
            "default": 4
          },
          "channelRoles": {
            "type": "array",
            "title": "Channel roles",
            "description": "One role per channel. Order matches DMX channels.",
            "items": { 
              "type": "string", 
              "enum": ["R", "G", "B", "W", "H", "L", "F"],
              "options": {
                "enum_titles": ["Red", "Green", "Blue", "White", "High (255)", "Low (0)", "Fixed value"]
              }
            }
          },
          "channelConfig": { 
            "type": "string", 
            "title": "Compact config (optional)",
            "description": "Shorthand like RGBH or RGBW. Overrides channelRoles if set.",
            "pattern": "^[RGBWHLF]*$"
          },
          "fixedValues": {
            "type": "array",
            "title": "Fixed values",
            "description": "Used for F roles (and as fallback). One value per channel.",
            "items": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0 }
          }
        }
      }
    },
    "ledFixtureMap": {
      "type": "array",
      "title": "LED to fixture index map",
      "description": "0-based index into the customFixtures list for each Hyperion LED. If shorter than LED count, the last entry is repeated. Leave empty to use fixture 0 for all.",
      "access": "expert",
      "propertyOrder": 8,
      "items": { "type": "integer", "minimum": 0 }
    },
    "latchTime": {
      "type": "integer",
      "title": "edt_dev_spec_latchtime_title",
      "default": 0,
      "append": "edt_append_ms",
      "minimum": 0,
      "maximum": 1000,
      "access": "expert",
      "propertyOrder": 6
    }
  },
  "additionalProperties": true
}
